#!/usr/bin/env python
# Build from this directory:
#   py -3.12 -m SCons platform=windows target=template_debug disable_exceptions=no -j8
#
# disable_exceptions=no is required: C++/WinRT (used for Windows.Graphics.Capture)
# reports errors through exceptions, and godot-cpp turns them off by default.

env = SConscript("godot-cpp/SConstruct", {"api_version": "4.7"})

env.Append(CPPPATH=["src/"])
env.Append(CPPDEFINES=["NOMINMAX", "WIN32_LEAN_AND_MEAN"])
env.Append(LIBS=["d3d11", "d3d12", "dxgi", "windowsapp", "user32", "advapi32", "mfplat", "mfuuid", "ws2_32", "ole32"])

# The Windows-only file is built as C++20: in C++17 mode C++/WinRT pulls in
# <experimental/coroutine>, which current MSVC rejects.
windows_sources = ["src/win_backend.cpp", "src/video_stream.cpp", "src/audio_stream.cpp", "src/game_link.cpp"]
windows_env = env.Clone()
windows_env.Append(CXXFLAGS=["/std:c++20"])

godot_sources = [source for source in Glob("src/*.cpp") if source.name not in ("win_backend.cpp", "video_stream.cpp", "audio_stream.cpp", "game_link.cpp")]
objects = env.SharedObject(godot_sources) + windows_env.SharedObject(windows_sources)

library = env.SharedLibrary(
    "../bin/workplace_native{}{}".format(env["suffix"], env["SHLIBSUFFIX"]),
    source=objects,
)

env.NoCache(library)
Default(library)

# workplace_agent.exe (see agent/agent.cpp): a plain Win32 program, no Godot.
# Static C runtime, so that it runs as SYSTEM without anything else installed;
# Windows subsystem, so that no console window appears in the user's session.
agent_env = Environment(TARGET_ARCH="x86_64", tools=["msvc", "mslink"])
agent_env.Append(CPPPATH=["src/"])
agent_env.Append(CPPDEFINES=["NOMINMAX", "WIN32_LEAN_AND_MEAN", "UNICODE", "_UNICODE"])
agent_env.Append(CXXFLAGS=["/std:c++17", "/EHsc", "/MT", "/O2", "/W3"])
agent_env.Append(LINKFLAGS=["/SUBSYSTEM:WINDOWS", "/ENTRY:wmainCRTStartup"])
agent_env.Append(LIBS=["user32", "advapi32", "wtsapi32", "d3d11", "dxgi", "sas"])
agent = agent_env.Program(
    "../bin/workplace_agent.exe",
    [
        agent_env.Object("agent/agent.obj", "agent/agent.cpp"),
        agent_env.Object("agent/secure_capture.obj", "agent/secure_capture.cpp"),
        agent_env.Object("agent/input_events_agent.obj", "src/input_events.cpp"),
    ],
)
Default(agent)

# The SteamVR driver (slice q1, see steamvr_driver/driver.cpp): a plain DLL that
# vrserver.exe loads from steamvr_driver/workplace (registered with
# tools/install_steamvr_driver.ps1). It shares the eyes' stream code with the
# module (video_stream.cpp, game_link.cpp; built again here without Godot). The
# OpenVR header is downloaded separately (see CLAUDE.md), like godot-cpp.
# SteamVR keeps the DLL open while it runs: close SteamVR before building.
driver_env = Environment(TARGET_ARCH="x86_64", tools=["msvc", "mslink"])
driver_env.Append(CPPPATH=["src/", "openvr/"])
driver_env.Append(CPPDEFINES=["NOMINMAX", "WIN32_LEAN_AND_MEAN", "_CRT_SECURE_NO_WARNINGS"])
driver_env.Append(CXXFLAGS=["/std:c++20", "/EHsc", "/MT", "/O2", "/W3", "/bigobj"])
driver_env.Append(LIBS=["d3d11", "d3dcompiler", "dxgi", "windowsapp", "user32", "advapi32", "mfplat", "mfuuid", "ws2_32", "ole32"])
driver = driver_env.SharedLibrary(
    "steamvr_driver/workplace/bin/win64/driver_workplace.dll",
    [
        driver_env.SharedObject("steamvr_driver/driver.obj", "steamvr_driver/driver.cpp"),
        driver_env.SharedObject("steamvr_driver/frame_compositor.obj", "steamvr_driver/frame_compositor.cpp"),
        driver_env.SharedObject("steamvr_driver/video_stream_driver.obj", "src/video_stream.cpp"),
        driver_env.SharedObject("steamvr_driver/game_link_driver.obj", "src/game_link.cpp"),
    ],
)
Default(driver)
