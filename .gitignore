# Godot 4+ specific ignores
.godot/
/android/

# Native module: godot-cpp is cloned separately (see CLAUDE.md), binaries are built locally
/native/godot-cpp/
/native/build.log
/native/.sconsign*.dblite
*.obj
/bin/*.dll
/bin/*.exe
/native/agent/*.obj
/bin/~*
/bin/*.lib
/bin/*.exp
/bin/*.pdb
/bin/*.ilk

# Personal Claude Code settings of this machine
.claude/settings.local.json

# The headset app (slice o): its cache, and the OpenXR vendors addon (installed from its release, not kept in git)
/headset/.godot/
/headset/addons/godotopenxrvendors/

# Built apps and the headset project's Android build template (regenerated on export)
/build/
/headset/android/
/headset/addons/workplace_video/bin/
/headset/shared/
